---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, getPostUrl, formatDate, categoryUrl, type Post } from '../lib/posts';

const posts = await getPublishedPosts();

const postsByYear = new Map<number, Post[]>();
for (const post of posts) {
  const year = post.data.pubDate.getFullYear();
  if (!postsByYear.has(year)) postsByYear.set(year, []);
  postsByYear.get(year)!.push(post);
}
const years = [...postsByYear.keys()].sort((a, b) => b - a);
---

<BaseLayout title="Archives">
  <div class="container">
    <header class="page-head">
      <h1>Archives</h1>
      <p>{years[years.length - 1]}년부터 쓴 글 {posts.length}편</p>
    </header>
    <div class="with-sidebar">
      <div>
        {years.map(year => (
          <section class="group">
            <h2 class="group-title" id={String(year)}>{year} <span class="count">{postsByYear.get(year)!.length}</span></h2>
            <ul class="compact-list">
              {postsByYear.get(year)!.map(post => (
                <li>
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                  <a class="title" href={getPostUrl(post)}>{post.data.title}</a>
                  <a class="aside category-chip" href={categoryUrl(post.data.category)}>{post.data.category}</a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      <aside class="sidebar">
        <section class="side-section">
          <h2>Years</h2>
          <ul class="side-list">
            {years.map(year => (
              <li><a href={`#${year}`}><span>{year}</span><span class="count">{postsByYear.get(year)!.length}</span></a></li>
            ))}
          </ul>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>
