---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import Pagination from '../../components/Pagination.astro';
import HomeSidebar from '../../components/HomeSidebar.astro';
import { getPublishedPosts } from '../../lib/posts';
import { POSTS_PER_PAGE } from '../../lib/pagination';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => {
    const page = i + 2;
    return {
      params: { page: String(page) },
      props: {
        pagePosts: posts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE),
        allPosts: posts,
        currentPage: page,
        totalPages,
      },
    };
  });
}

const { pagePosts, allPosts, currentPage, totalPages } = Astro.props;
---

<BaseLayout title={`Page ${currentPage}`}>
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">Page {currentPage} / {totalPages}</p>
      <h1>gwimong's blog</h1>
    </header>
    <div class="with-sidebar">
      <div>
        <PostList posts={pagePosts} />
        <Pagination current={currentPage} total={totalPages} />
      </div>
      <HomeSidebar posts={allPosts} />
    </div>
  </div>
</BaseLayout>
