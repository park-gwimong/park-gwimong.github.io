---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getCollection } from 'astro:content';
import { getPublishedPosts, slugifyTag } from '../../lib/posts';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const published = await getPublishedPosts();
  const tagMap = new Map<string, string>(); // slug -> original tag

  allPosts.forEach(post => {
    post.data.tags.forEach(tag => {
      const slug = slugifyTag(tag);
      if (!tagMap.has(slug)) tagMap.set(slug, tag);
    });
  });

  return [...tagMap.entries()].map(([slug, originalTag]) => ({
    params: { tag: slug },
    props: {
      posts: published.filter(post => post.data.tags.some(t => slugifyTag(t) === slug)),
      tagName: originalTag,
    },
  }));
}

const { posts, tagName } = Astro.props;
---

<BaseLayout title={`Tag: ${tagName}`}>
  <div class="container">
    <div style="max-width: var(--prose)">
      <header class="page-head">
        <p class="eyebrow">Tag</p>
        <h1>#{tagName}</h1>
        <p>{posts.length}편의 글</p>
      </header>
      <PostList posts={posts} />
    </div>
  </div>
</BaseLayout>
