---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getPostUrl, formatDate, slugifyTag, type Post } from '../../lib/posts';

const posts = await getPublishedPosts();

const postsByTag = new Map<string, { name: string; posts: Post[] }>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    const slug = slugifyTag(tag);
    if (!postsByTag.has(slug)) postsByTag.set(slug, { name: tag, posts: [] });
    postsByTag.get(slug)!.posts.push(post);
  }
}
const tagSlugs = [...postsByTag.keys()].sort();
const byCount = [...tagSlugs].sort((a, b) => postsByTag.get(b)!.posts.length - postsByTag.get(a)!.posts.length);
---

<BaseLayout title="Tags">
  <div class="container">
    <header class="page-head">
      <h1>Tags</h1>
      <p>태그 {tagSlugs.length}개</p>
    </header>

    <div class="tag-cloud" style="margin-bottom: 56px">
      {byCount.map(slug => (
        <a class="tag" href={`#${slug}`}>#{postsByTag.get(slug)!.name}<span class="count">{postsByTag.get(slug)!.posts.length}</span></a>
      ))}
    </div>

    <div style="max-width: var(--prose)">
      {tagSlugs.map(slug => (
        <section class="group">
          <h2 class="group-title" id={slug}>
            <a href={`/tag/${slug}/`} style="color: inherit">#{postsByTag.get(slug)!.name}</a>
            <span class="count">{postsByTag.get(slug)!.posts.length}</span>
          </h2>
          <ul class="compact-list">
            {postsByTag.get(slug)!.posts.map(post => (
              <li>
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                <a class="title" href={getPostUrl(post)}>{post.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
