---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

function slugifyTag(tag: string): string {
  return tag.toLowerCase()
    .replace(/\//g, '-')
    .replace(/\s+/g, '-')
    .replace(/[^a-z0-9가-힣-]/g, '')
    .replace(/-+/g, '-')
    .replace(/^-|-$/g, '');
}

const allPosts = await getCollection('posts');
const sortedPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Group posts by tag (using slug as key, but keeping original name)
const postsByTag: Record<string, { posts: typeof sortedPosts, originalName: string }> = {};
sortedPosts.forEach(post => {
  post.data.tags.forEach(tag => {
    const slug = slugifyTag(tag);
    if (!postsByTag[slug]) {
      postsByTag[slug] = { posts: [], originalName: tag };
    }
    postsByTag[slug].posts.push(post);
  });
});

const tagSlugs = Object.keys(postsByTag).sort();

function formatDate(date: Date): string {
  return date.toISOString().split('T')[0];
}

function getPostUrl(post: typeof sortedPosts[0]): string {
  const date = new Date(post.data.pubDate);
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');
  const slugParts = post.slug.split('/');
  const fileSlug = slugParts[slugParts.length - 1];
  return `/${year}/${month}/${day}/${fileSlug}/`;
}
---

<BaseLayout title="Tags">
  <div class="page clearfix">
    <div class="left">
      <h1>Tags</h1>
      <hr>
      <ul>
        {tagSlugs.map(slug => (
          <>
            <h2 id={slug}>{postsByTag[slug].originalName} ({postsByTag[slug].posts.length})</h2>
            {postsByTag[slug].posts.map(post => (
              <li>
                <time>{formatDate(post.data.pubDate)}</time>
                <a class="title" href={getPostUrl(post)}>{post.data.title}</a>
              </li>
            ))}
          </>
        ))}
      </ul>
    </div>
    <div class="right">
      <div class="wrap">
        <div class="side">
          <div><i class="fa fa-tags"></i> Tags</div>
          <div class="tags-cloud">
            {tagSlugs.map(slug => {
              const count = postsByTag[slug].posts.length;
              const size = Math.min(9 + count * 2, 18);
              return <a href={`#${slug}`} style={`font-size: ${size}pt;`}>{postsByTag[slug].originalName}</a>;
            })}
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
