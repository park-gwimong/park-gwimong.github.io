---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const categories = [...new Set(posts.map(post => post.data.category))];
const tags = [...new Set(posts.flatMap(post => post.data.tags))];
---

<BaseLayout title="About">
  <div class="page clearfix">
    <div class="left">
      <h1>About</h1>
      <hr>

      <div class="about-container">
        <!-- Profile Section -->
        <section class="profile-section">
          <div class="profile-header">
            <div class="profile-avatar">
              <i class="fa fa-user-circle"></i>
            </div>
            <div class="profile-info">
              <h2 class="profile-name">Gwimong Park</h2>
              <p class="profile-role">Software Engineer</p>
              <p class="profile-bio">
                개발하면서 겪었던 문제들과 해결 과정을 기록하고 공유합니다.
              </p>
            </div>
          </div>
        </section>

        <!-- Stats Section -->
        <section class="stats-section">
          <div class="stat-item">
            <span class="stat-number">{posts.length}</span>
            <span class="stat-label">Posts</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">{categories.length}</span>
            <span class="stat-label">Categories</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">{tags.length}</span>
            <span class="stat-label">Tags</span>
          </div>
        </section>

        <!-- Skills Section -->
        <section class="skills-section">
          <h3><i class="fa fa-code"></i> Tech Stack</h3>
          <div class="skill-groups">
            <div class="skill-group">
              <h4>Languages</h4>
              <div class="skill-tags">
                <span class="skill-tag">Java</span>
                <span class="skill-tag">JavaScript</span>
                <span class="skill-tag">C#</span>
                <span class="skill-tag">C/C++</span>
                <span class="skill-tag">Python</span>
              </div>
            </div>
            <div class="skill-group">
              <h4>Frameworks</h4>
              <div class="skill-tags">
                <span class="skill-tag">Spring</span>
                <span class="skill-tag">Qt</span>
                <span class="skill-tag">.NET</span>
              </div>
            </div>
            <div class="skill-group">
              <h4>Infrastructure</h4>
              <div class="skill-tags">
                <span class="skill-tag">AWS</span>
                <span class="skill-tag">Linux</span>
                <span class="skill-tag">Docker</span>
                <span class="skill-tag">GitLab CI/CD</span>
              </div>
            </div>
          </div>
        </section>

        <!-- Blog Topics Section -->
        <section class="topics-section">
          <h3><i class="fa fa-folder-open"></i> Blog Topics</h3>
          <div class="topic-list">
            {categories.sort().map(category => (
              <a href={`/category/${category.toLowerCase()}/`} class="topic-item">
                {category}
              </a>
            ))}
          </div>
        </section>

        <!-- Contact Section -->
        <section class="contact-section">
          <h3><i class="fa fa-envelope"></i> Contact</h3>
          <div class="contact-links">
            <a href="https://github.com/park-gwimong" class="contact-link github" target="_blank" rel="noopener">
              <i class="fa fa-github"></i>
              <span>GitHub</span>
            </a>
            <a href="mailto:park.gwimong@gmail.com" class="contact-link email">
              <i class="fa fa-envelope"></i>
              <span>Email</span>
            </a>
            <a href="https://www.linkedin.com/in/박귀몽" class="contact-link linkedin" target="_blank" rel="noopener">
              <i class="fa fa-linkedin"></i>
              <span>LinkedIn</span>
            </a>
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about-container {
    max-width: 800px;
  }

  /* Profile Section */
  .profile-section {
    margin-bottom: 40px;
  }

  .profile-header {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  .profile-avatar {
    width: 120px;
    height: 120px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .profile-avatar i {
    font-size: 60px;
    color: #fff;
  }

  .profile-info {
    flex: 1;
  }

  .profile-name {
    font-size: 28px;
    font-weight: 600;
    margin: 0 0 5px 0;
    border: none;
    color: #333;
  }

  .profile-role {
    font-size: 18px;
    color: #667eea;
    margin: 0 0 10px 0;
    font-weight: 500;
  }

  .profile-bio {
    color: #666;
    line-height: 1.6;
    margin: 0;
  }

  /* Stats Section */
  .stats-section {
    display: flex;
    gap: 20px;
    margin-bottom: 40px;
    padding: 20px;
    background: linear-gradient(135deg, #f5f7fa 0%, #e4e8ec 100%);
    border-radius: 12px;
  }

  .stat-item {
    flex: 1;
    text-align: center;
    padding: 15px;
  }

  .stat-number {
    display: block;
    font-size: 32px;
    font-weight: 700;
    color: #667eea;
  }

  .stat-label {
    font-size: 14px;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* Skills Section */
  .skills-section {
    margin-bottom: 40px;
  }

  .skills-section h3 {
    font-size: 20px;
    margin: 0 0 20px 0;
    color: #333;
    font-weight: 600;
  }

  .skills-section h3 i {
    margin-right: 10px;
    color: #667eea;
  }

  .skill-groups {
    display: grid;
    gap: 20px;
  }

  .skill-group h4 {
    font-size: 14px;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0 0 10px 0;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .skill-tag {
    padding: 6px 14px;
    background: #f0f0f0;
    border-radius: 20px;
    font-size: 14px;
    color: #555;
    transition: all 0.2s ease;
  }

  .skill-tag:hover {
    background: #667eea;
    color: #fff;
  }

  /* Topics Section */
  .topics-section {
    margin-bottom: 40px;
  }

  .topics-section h3 {
    font-size: 20px;
    margin: 0 0 20px 0;
    color: #333;
    font-weight: 600;
  }

  .topics-section h3 i {
    margin-right: 10px;
    color: #667eea;
  }

  .topic-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .topic-item {
    padding: 8px 16px;
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    font-size: 14px;
    color: #555;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .topic-item:hover {
    border-color: #667eea;
    color: #667eea;
    background: #f8f9ff;
  }

  /* Contact Section */
  .contact-section {
    margin-bottom: 20px;
  }

  .contact-section h3 {
    font-size: 20px;
    margin: 0 0 20px 0;
    color: #333;
    font-weight: 600;
  }

  .contact-section h3 i {
    margin-right: 10px;
    color: #667eea;
  }

  .contact-links {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 24px;
    border-radius: 8px;
    font-size: 15px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .contact-link i {
    font-size: 20px;
  }

  .contact-link.github {
    background: #24292e;
    color: #fff;
  }

  .contact-link.github:hover {
    background: #000;
  }

  .contact-link.email {
    background: #ea4335;
    color: #fff;
  }

  .contact-link.email:hover {
    background: #c5221f;
  }

  .contact-link.linkedin {
    background: #0077b5;
    color: #fff;
  }

  .contact-link.linkedin:hover {
    background: #005885;
  }

  /* Responsive */
  @media screen and (max-width: 770px) {
    .profile-header {
      flex-direction: column;
      text-align: center;
    }

    .profile-avatar {
      width: 100px;
      height: 100px;
    }

    .profile-avatar i {
      font-size: 50px;
    }

    .profile-name {
      font-size: 24px;
    }

    .stats-section {
      flex-direction: column;
      gap: 10px;
    }

    .stat-item {
      padding: 10px;
    }

    .stat-number {
      font-size: 28px;
    }

    .contact-links {
      flex-direction: column;
    }

    .contact-link {
      justify-content: center;
    }
  }
</style>
