---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import Pagination from '../components/Pagination.astro';
import HomeSidebar from '../components/HomeSidebar.astro';
import { getPublishedPosts } from '../lib/posts';
import { POSTS_PER_PAGE } from '../lib/pagination';

const posts = await getPublishedPosts();
const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
---

<BaseLayout>
  <div class="container">
    <header class="page-head">
      <h1>gwimong's blog</h1>
      <p>무인기 관제 소프트웨어를 만들며 부딪힌 문제와 판단을 기록합니다.</p>
    </header>
    <div class="with-sidebar">
      <div>
        <PostList posts={posts.slice(0, POSTS_PER_PAGE)} />
        <Pagination current={1} total={totalPages} />
      </div>
      <HomeSidebar posts={posts} />
    </div>
  </div>
</BaseLayout>
