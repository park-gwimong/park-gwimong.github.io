---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

function slugifyTag(tag: string): string {
  return tag.toLowerCase()
    .replace(/\//g, '-')
    .replace(/\s+/g, '-')
    .replace(/[^a-z0-9가-힣-]/g, '')
    .replace(/-+/g, '-')
    .replace(/^-|-$/g, '');
}

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const categories = [...new Set(allPosts.map(post => post.data.category.toLowerCase()))];

  return categories.map(category => ({
    params: { category },
    props: {
      posts: allPosts
        .filter(post => post.data.category.toLowerCase() === category && !post.data.draft)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
      categoryName: allPosts.find(p => p.data.category.toLowerCase() === category)?.data.category || category,
    },
  }));
}

const { posts, categoryName } = Astro.props;

function formatDate(date: Date): string {
  return date.toISOString().split('T')[0];
}

function getPostUrl(post: any): string {
  const date = new Date(post.data.pubDate);
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');
  const slugParts = post.slug.split('/');
  const fileSlug = slugParts[slugParts.length - 1];
  return `/${year}/${month}/${day}/${fileSlug}/`;
}
---

<BaseLayout title={`Category: ${categoryName}`}>
  <div class="page clearfix">
    <div class="left">
      <h1>Category: {categoryName}</h1>
      <p>{posts.length} posts</p>
      <hr>
      <ul>
        {posts.map((post: any) => (
          <li>
            <time>{formatDate(post.data.pubDate)}</time>
            <a class="title" href={getPostUrl(post)}>{post.data.title}</a>
            <span class="pageTag">
              {post.data.tags.map((tag: string, i: number) => (
                <>
                  <a href={`/tag/${slugifyTag(tag)}/`}>{tag}</a>
                  {i < post.data.tags.length - 1 && ' '}
                </>
              ))}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</BaseLayout>
