---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getPostUrl, formatDate, categoryUrl, type Post } from '../../lib/posts';

const posts = await getPublishedPosts();

const postsByCategory = new Map<string, Post[]>();
for (const post of posts) {
  const cat = post.data.category;
  if (!postsByCategory.has(cat)) postsByCategory.set(cat, []);
  postsByCategory.get(cat)!.push(post);
}
const categories = [...postsByCategory.keys()].sort();
---

<BaseLayout title="Categories">
  <div class="container">
    <header class="page-head">
      <h1>Categories</h1>
      <p>{categories.length}개 분류, {posts.length}편</p>
    </header>
    <div class="with-sidebar">
      <div>
        {categories.map(cat => (
          <section class="group">
            <h2 class="group-title" id={cat}>
              <a href={categoryUrl(cat)} style="color: inherit">{cat}</a>
              <span class="count">{postsByCategory.get(cat)!.length}</span>
            </h2>
            <ul class="compact-list">
              {postsByCategory.get(cat)!.map(post => (
                <li>
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                  <a class="title" href={getPostUrl(post)}>{post.data.title}</a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      <aside class="sidebar">
        <section class="side-section">
          <h2>Categories</h2>
          <ul class="side-list">
            {categories.map(cat => (
              <li><a href={`#${cat}`}><span>{cat}</span><span class="count">{postsByCategory.get(cat)!.length}</span></a></li>
            ))}
          </ul>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>
