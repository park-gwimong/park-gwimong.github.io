---
import { getCollection } from 'astro:content';
import PostLayout from '../../../../layouts/PostLayout.astro';
import { getPostUrl, readingMinutes } from '../../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  // 이전·다음 글은 공개된 글 사이에서만 연결한다 (오래된 글 → 최신 글 순)
  const published = posts
    .filter(p => !p.data.draft)
    .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());

  return posts.map((post) => {
    const [, year, month, day, slug] = getPostUrl(post).split('/');
    const i = published.indexOf(post);
    return {
      params: { year, month, day, slug },
      props: {
        post,
        prev: i > 0 ? published[i - 1] : undefined,
        next: i >= 0 && i < published.length - 1 ? published[i + 1] : undefined,
      },
    };
  });
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await post.render();
---

<PostLayout frontmatter={post.data} headings={headings} readingTime={readingMinutes(post.body)} prev={prev} next={next}>
  <Content />
</PostLayout>
