---
import BaseLayout from './BaseLayout.astro';
import type { MarkdownHeading } from 'astro';
import { type Post, formatDate, slugifyTag, categoryUrl, getPostUrl } from '../lib/posts';

interface Props {
  frontmatter: Post['data'];
  headings: MarkdownHeading[];
  readingTime: number;
  prev?: Post;
  next?: Post;
}

const { frontmatter, headings, readingTime, prev, next } = Astro.props;
const { title, subtitle, pubDate, updatedDate, category, tags, math } = frontmatter;

const toc = headings
  .filter(h => h.depth === 2 || h.depth === 3)
  .map(h => ({ ...h, text: h.text.replace(/^[\d.]+\s+/, '') }));
---

<BaseLayout title={title} description={subtitle || title} showProgress>
  <div class="container">
    <div class="post-wrap">
      <article itemscope itemtype="http://schema.org/BlogPosting">
        <header class="post-header">
          <a class="category-chip" href={categoryUrl(category)}>{category}</a>
          <h1 itemprop="headline">{title}</h1>
          {subtitle && <p class="subtitle">{subtitle}</p>}
          <div class="meta">
            <time datetime={pubDate.toISOString()} itemprop="datePublished">{formatDate(pubDate)}</time>
            {updatedDate && (
              <span class="dot">수정 <time datetime={updatedDate.toISOString()} itemprop="dateModified">{formatDate(updatedDate)}</time></span>
            )}
            <span class="dot">{readingTime}분 분량</span>
          </div>
          {tags.length > 0 && (
            <ul class="tag-list">
              {tags.map(tag => <li><a class="tag" href={`/tag/${slugifyTag(tag)}/`}>#{tag}</a></li>)}
            </ul>
          )}
        </header>

        {toc.length > 1 && (
          <details class="toc-inline">
            <summary>목차</summary>
            <nav class="toc" aria-label="목차">
              <ul>
                {toc.map(h => <li class={`depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
              </ul>
            </nav>
          </details>
        )}

        <div class="prose" itemprop="articleBody">
          <slot />
        </div>

        <footer class="post-footer">
          {(prev || next) && (
            <nav class="post-nav" aria-label="이전·다음 글">
              {prev && (
                <a class="prev" href={getPostUrl(prev)}>
                  <span class="label">← 이전 글</span>
                  <span class="t">{prev.data.title}</span>
                </a>
              )}
              {next && (
                <a class="next" href={getPostUrl(next)}>
                  <span class="label">다음 글 →</span>
                  <span class="t">{next.data.title}</span>
                </a>
              )}
            </nav>
          )}

          <section class="comments">
            <h2 id="comments">Comments</h2>
            <div id="disqus_thread"></div>
          </section>
        </footer>
      </article>

      <aside class="toc-aside">
        {toc.length > 1 && (
          <>
            <p class="toc-title">On this page</p>
            <nav class="toc" id="tocSide" aria-label="목차">
              <ul>
                {toc.map(h => <li class={`depth-${h.depth}`}><a href={`#${h.slug}`} data-target={h.slug}>{h.text}</a></li>)}
              </ul>
            </nav>
          </>
        )}
      </aside>
    </div>
  </div>

  {math && (
    <script is:inline>
      window.MathJax = {
        tex: { inlineMath: [["$","$"],["\\(","\\)"]] },
        options: { skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre'] }
      };
    </script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/3.2.2/es5/tex-mml-chtml.min.js"></script>
  )}

  <script is:inline>
    (function () {
      var prose = document.querySelector('.prose');
      if (!prose) return;

      // 제목 옆 앵커 링크
      prose.querySelectorAll('h2[id], h3[id], h4[id]').forEach(function (h) {
        var a = document.createElement('a');
        a.className = 'heading-anchor';
        a.href = '#' + h.id;
        a.setAttribute('aria-label', '이 섹션 링크');
        a.textContent = '#';
        h.prepend(a);
      });

      // 표: 가로 스크롤 래퍼
      prose.querySelectorAll('table').forEach(function (t) {
        var wrap = document.createElement('div');
        wrap.className = 'table-wrap';
        t.parentNode.insertBefore(wrap, t);
        wrap.appendChild(t);
      });

      // 코드 블록: 언어 표시 + 복사 버튼
      var copyIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg>';
      prose.querySelectorAll('pre').forEach(function (pre) {
        var lang = pre.getAttribute('data-language') || '';
        if (lang === 'plaintext') lang = 'text';
        var block = document.createElement('div');
        block.className = 'code-block';
        var head = document.createElement('div');
        head.className = 'code-head';
        var label = document.createElement('span');
        label.textContent = lang;
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'copy-btn';
        btn.innerHTML = copyIcon + '<span>복사</span>';
        btn.addEventListener('click', function () {
          var text = pre.querySelector('code') ? pre.querySelector('code').innerText : pre.innerText;
          navigator.clipboard.writeText(text.replace(/\n$/, '')).then(function () {
            btn.classList.add('copied');
            btn.lastChild.textContent = '복사됨';
            setTimeout(function () {
              btn.classList.remove('copied');
              btn.lastChild.textContent = '복사';
            }, 1500);
          });
        });
        head.appendChild(label);
        head.appendChild(btn);
        pre.parentNode.insertBefore(block, pre);
        block.appendChild(head);
        block.appendChild(pre);
      });

      // 외부 링크만 새 탭으로
      prose.querySelectorAll('a[href^="http"]').forEach(function (a) {
        if (a.hostname !== location.hostname) {
          a.target = '_blank';
          a.rel = 'noopener';
        }
      });

      // 목차: 현재 읽는 섹션 강조
      var links = document.querySelectorAll('#tocSide a[data-target]');
      if (links.length) {
        var targets = Array.prototype.map.call(links, function (a) {
          return document.getElementById(a.getAttribute('data-target'));
        }).filter(Boolean);
        var current = null;
        function update() {
          var offset = 120;
          var active = targets[0];
          for (var i = 0; i < targets.length; i++) {
            if (targets[i].getBoundingClientRect().top - offset <= 0) active = targets[i];
            else break;
          }
          if (active === current) return;
          current = active;
          links.forEach(function (a) {
            a.classList.toggle('active', a.getAttribute('data-target') === active.id);
          });
        }
        var pending = false;
        window.addEventListener('scroll', function () {
          if (!pending) { pending = true; requestAnimationFrame(function () { pending = false; update(); }); }
        }, { passive: true });
        update();
      }

      // 모바일 목차: 항목을 누르면 닫는다
      var inline = document.querySelector('.toc-inline');
      if (inline) {
        inline.addEventListener('click', function (e) {
          if (e.target.tagName === 'A') inline.open = false;
        });
      }
    })();

    // Disqus
    var disqus_config = function () {
      this.page.url = window.location.href;
      this.page.identifier = window.location.pathname;
    };
    (function () {
      var d = document, s = d.createElement('script');
      s.src = 'https://park-gwimong-github-io.disqus.com/embed.js';
      s.setAttribute('data-timestamp', +new Date());
      (d.head || d.body).appendChild(s);
    })();
    // 테마가 바뀌면 Disqus가 새 배경색을 다시 읽도록 리셋한다
    document.addEventListener('themechange', function () {
      if (window.DISQUS) window.DISQUS.reset({ reload: true, config: disqus_config });
    });
  </script>
</BaseLayout>
