---
interface Props {
  current: number;
  total: number;
}

const { current, total } = Astro.props;
const href = (n: number) => (n === 1 ? '/' : `/page/${n}/`);

// 처음·끝 페이지와 현재 페이지 주변만 보여주고 나머지는 생략 표시로 줄인다
const shown = [...new Set([1, total, current - 1, current, current + 1])]
  .filter(n => n >= 1 && n <= total)
  .sort((a, b) => a - b);
const items: (number | 'gap')[] = [];
shown.forEach((n, i) => {
  if (i > 0 && n - shown[i - 1] > 1) items.push('gap');
  items.push(n);
});
---

{total > 1 && (
  <nav class="pagination" aria-label="페이지">
    {current > 1
      ? <a href={href(current - 1)} aria-label="이전 페이지">←</a>
      : <span class="disabled" aria-hidden="true">←</span>}
    {items.map(n => n === 'gap'
      ? <span class="current" aria-hidden="true">…</span>
      : n === current
        ? <span class="current" aria-current="page">{n}</span>
        : <a href={href(n)}>{n}</a>)}
    {current < total
      ? <a href={href(current + 1)} aria-label="다음 페이지">→</a>
      : <span class="disabled" aria-hidden="true">→</span>}
  </nav>
)}
